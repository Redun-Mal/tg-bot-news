# Copy to .env and fill in real values. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the only person the bot will respond to.
TELEGRAM_ALLOWED_USER_ID=

# --- Claude API ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tg_news
POSTGRES_USER=tg_news
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tg_news:${POSTGRES_PASSWORD}@postgres:5432/tg_news

# --- RSSHub (self-hosted, Telegram public-channel scrape route) ---
RSS_BASE_URL=http://rsshub:1200

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5679
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Bishkek
TZ=Asia/Bishkek
N8N_ENCRYPTION_KEY=

# --- helper-api (internal service, not exposed to host) ---
HELPER_API_PORT=3000
