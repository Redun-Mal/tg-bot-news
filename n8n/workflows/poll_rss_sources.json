{
  "name": "poll_rss_sources",
  "nodes": [
    {
      "id": "trigger",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "pg-select-sources",
      "name": "Active sources",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-160, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres — tg_news"
        }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT id, rss_url, channel_username FROM sources WHERE status = 'active' ORDER BY last_checked_at NULLS FIRST",
        "options": {}
      }
    },
    {
      "id": "http-fetch-feed",
      "name": "Fetch RSS feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 0],
      "continueOnFail": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.rss_url }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "if-fetch-ok",
      "name": "Fetch succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [320, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.error === undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "pg-mark-failure",
      "name": "Record fetch failure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [560, 200],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres — tg_news"
        }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "UPDATE sources SET last_checked_at = now(), error_count = error_count + 1, status = CASE WHEN error_count + 1 >= 5 THEN 'error' ELSE status END WHERE id = $1 RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $('Active sources').item.json.id ] }}"
        }
      }
    },
    {
      "id": "pg-log-failure",
      "name": "Log fetch failure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [800, 200],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres — tg_news"
        }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow_name, level, message, metadata) VALUES ('poll_rss_sources', 'warn', $1, jsonb_build_object('sourceId', $2::int)) RETURNING id",
        "options": {
          "queryReplacement": "={{ [ 'RSS fetch failed for source ' + $('Active sources').item.json.id, $('Active sources').item.json.id ] }}"
        }
      }
    },
    {
      "id": "pg-mark-success",
      "name": "Record fetch success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [560, -200],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres — tg_news"
        }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "UPDATE sources SET last_checked_at = now(), last_success_at = now(), error_count = 0, status = CASE WHEN status = 'error' THEN 'active' ELSE status END WHERE id = $1 RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $('Active sources').item.json.id ] }}"
        }
      }
    },
    {
      "id": "code-parse-feed",
      "name": "Parse feed items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sourceItems = $('Active sources').all();\nconst httpItems = $input.all();\nconst results = [];\nfor (let i = 0; i < httpItems.length; i++) {\n  const sourceId = sourceItems[i].json.id;\n  const body = httpItems[i].json.data || '';\n  const itemBlocks = body.match(/<item>[\\s\\S]*?<\\/item>/g) || [];\n  for (const block of itemBlocks) {\n    const get = (tag) => {\n      const m = block.match(new RegExp(`<${tag}>([\\\\s\\\\S]*?)<\\\\/${tag}>`));\n      if (!m) return null;\n      return m[1].replace('<![CDATA[', '').replace(']]>', '').trim();\n    };\n    const title = get('title') || '';\n    const link = get('link') || '';\n    const guid = get('guid');\n    const description = get('description') || '';\n    const pubDate = get('pubDate');\n    if (!link) continue;\n    results.push({ json: { sourceId, title, link, guid, description, pubDate } });\n  }\n}\nreturn results;"
      }
    },
    {
      "id": "http-normalize",
      "name": "Normalize text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPER_API_URL }}/normalize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.description }) }}",
        "options": {}
      }
    },
    {
      "id": "code-merge",
      "name": "Merge normalized fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Parse feed items').item.json;\nreturn { json: { ...original, normalizedText: $json.normalizedText, contentHash: $json.contentHash } };"
      }
    },
    {
      "id": "pg-insert-post",
      "name": "Insert post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1280, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres — tg_news"
        }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "INSERT INTO posts (source_id, external_id, post_url, title, raw_text, normalized_text, content_hash, published_at) VALUES ($1, $2, $3, $4, $5, $6, $7, NULLIF($8, '')::timestamptz) ON CONFLICT DO NOTHING RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $json.sourceId, $json.guid, $json.link, $json.title, $json.description, $json.normalizedText, $json.contentHash, ($json.pubDate || '') ] }}"
        }
      }
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [
        [
          {
            "node": "Active sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Active sources": {
      "main": [
        [
          {
            "node": "Fetch RSS feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS feed": {
      "main": [
        [
          {
            "node": "Fetch succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch succeeded?": {
      "main": [
        [
          {
            "node": "Record fetch success",
            "type": "main",
            "index": 0
          },
          {
            "node": "Parse feed items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record fetch failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record fetch failure": {
      "main": [
        [
          {
            "node": "Log fetch failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse feed items": {
      "main": [
        [
          {
            "node": "Normalize text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize text": {
      "main": [
        [
          {
            "node": "Merge normalized fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge normalized fields": {
      "main": [
        [
          {
            "node": "Insert post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "El0evc0X113sLWow"
  }
}
